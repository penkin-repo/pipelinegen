<UserControl x:Class="PipelineGenWpf.Controls.CopyableContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Header View Switcher & Stats -->
        <DockPanel Margin="0,0,0,6">
            <Border DockPanel.Dock="Left"
                    Background="{StaticResource Surface2Brush}"
                    BorderBrush="{StaticResource BorderBrushMain}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="1">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnRendered"
                            Content="Просмотр"
                            Click="BtnRendered_Click"
                            Padding="8,2"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            BorderThickness="0"
                            Background="{StaticResource SurfaceBrush}"
                            Foreground="{StaticResource TextBrush}" />
                    <Button x:Name="BtnRaw"
                            Content="Исходник"
                            Click="BtnRaw_Click"
                            Padding="8,2"
                            FontSize="11"
                            FontWeight="Normal"
                            Cursor="Hand"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtCharCount"
                       DockPanel.Dock="Right"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10.5"
                       Foreground="{StaticResource MutedBrush}" />
        </DockPanel>

        <!-- Quick Access Toolbar for detected <copy> tags -->
        <Border x:Name="CopyToolbarBorder"
                Visibility="Collapsed"
                Background="{StaticResource Surface2Brush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8,6"
                Margin="0,0,0,6">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock x:Name="TxtCopyCount"
                               DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource LabelBrush}" />
                    <Button x:Name="BtnCopyAllTags"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Content="Копировать всё"
                            Click="BtnCopyAllTags_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            FontSize="11"
                            MinHeight="22"
                            Padding="7,2" />
                </DockPanel>
                <WrapPanel x:Name="CopyChipsPanel" />
            </StackPanel>
        </Border>

        <!-- Rendered Markdown View -->
        <FlowDocumentScrollViewer x:Name="DocViewer"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsToolBarVisible="False"
                                  PreviewMouseWheel="DocViewer_PreviewMouseWheel" />

        <!-- Raw Text View -->
        <TextBox x:Name="RawTextBox"
                 Visibility="Collapsed"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Background="{StaticResource SurfaceBrush}"
                 BorderBrush="{StaticResource BorderSoftBrush}"
                 BorderThickness="1"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="12"
                 Foreground="{StaticResource TextBrush}"
                 Padding="8"
                 MinHeight="140" />
    </StackPanel>
</UserControl>
