<Window x:Class="PipelineGenWpf.Views.ReadmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="README.md"
        Icon="/Resources/app.ico"
        Width="700"
        Height="560"
        MinWidth="500"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopy"
                            Content="Копировать"
                            Click="BtnCopy_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,0" />
                    <Button Content="Закрыть"
                            Click="BtnClose_Click"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>

                <TextBlock x:Name="TxtTitle"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Body -->
        <Border Grid.Row="1" Padding="12">
            <TextBox x:Name="TxtReadme"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MonoTextBoxStyle}"
                     Padding="10"
                     FontSize="12" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="TxtFooter"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}" />
        </Border>
    </Grid>
</Window>
