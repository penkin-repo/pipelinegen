<UserControl x:Class="PipelineGenWpf.Views.PipelineRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PipelineGenWpf.Controls"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Runner Action Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnClearAll"
                            Content="Сбросить"
                            ToolTip="Очистить введенные данные и результаты"
                            Click="BtnClearAll_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,6,0" />

                    <Button x:Name="BtnRunAll"
                            Content="▶ Запустить"
                            Click="BtnRunAll_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource AccentBrush}"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="РЕЖИМ ЗАПУСКА"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtProjectSubtitle"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="8,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Scrollable Body -->
        <ScrollViewer x:Name="RunnerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" Margin="14,12,14,24">
                <!-- Sequential Step Cards -->
                <StackPanel x:Name="StepsPanel" />

                <!-- Final Result Section -->
                <Border x:Name="FinalResultCard"
                        Visibility="Collapsed"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource GreenBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="BtnCopyFinal"
                                    DockPanel.Dock="Right"
                                    Content="Копировать"
                                    Click="BtnCopyFinal_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <TextBlock Text="Итоговый результат"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GreenBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Height="1" Background="{StaticResource BorderLightBrush}" Margin="0,0,0,8" />

                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,8"
                                MinHeight="160">
                            <controls:CopyableContentControl x:Name="FinalContentControl" />
                        </Border>

                        <!-- Follow-up Reply Box -->
                        <Border Background="{StaticResource Surface2Brush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="10,8"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Ответить модели:"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource LabelBrush}"
                                           Margin="0,0,0,5" />

                                <TextBox x:Name="TxtFollowUp"
                                         Style="{StaticResource MonoTextBoxStyle}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="64"
                                         MaxHeight="180"
                                         Margin="0,0,0,8" />

                                <DockPanel>
                                    <Button x:Name="BtnSaveFollowUpStep"
                                            DockPanel.Dock="Left"
                                            Visibility="Collapsed"
                                            Click="BtnSaveFollowUpStep_Click"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            FontSize="11.5" />

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Запустить заново"
                                                Click="BtnRunAll_Click"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,6,0" />
                                        <Button x:Name="BtnSendFollowUp"
                                                Content="Отправить"
                                                Click="BtnSendFollowUp_Click"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
