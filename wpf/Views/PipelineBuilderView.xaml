<UserControl x:Class="PipelineGenWpf.Views.PipelineBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BuilderBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Builder Mode Strip -->
        <Border Grid.Row="0"
                Background="{StaticResource BuilderToolbarBrush}"
                BorderBrush="{StaticResource BuilderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="Редактирование структуры · автосохранение"
                           FontSize="11"
                           Foreground="{StaticResource AmberTextBrush}"
                           VerticalAlignment="Center" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7"
                             Fill="{StaticResource AmberAccentBrush}"
                             Margin="0,0,7,0"
                             VerticalAlignment="Center" />
                    <TextBlock Text="РЕЖИМ КОНСТРУКТОРА"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AmberTextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtStepCount"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" Margin="14,12,14,24">
                <!-- Compact Project Description -->
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BuilderBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,7"
                        Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Описание:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource LabelBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <TextBox x:Name="TxtProjectDescription"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="12"
                                 Padding="6,3"
                                 TextChanged="TxtProjectDescription_TextChanged" />
                    </DockPanel>
                </Border>

            <!-- Dynamic Steps List -->
            <StackPanel x:Name="StepsPanel" />

            <!-- Compact Add Step Button + Popup -->
            <Grid Margin="0,4,0,0">
                <Button x:Name="BtnAddStep"
                        Content="+ Добавить шаг"
                        Click="BtnAddStep_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="12,5" />

                <Popup x:Name="AddStepPopup"
                       PlacementTarget="{Binding ElementName=BtnAddStep}"
                       Placement="Top"
                       VerticalOffset="-4"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrushMain}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="3"
                            Width="210">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.14" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <Button Content="Текстовое поле"
                                    Click="BtnAddTextStep_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,5"
                                    FontSize="12"
                                    Foreground="{StaticResource TextBrush}" />

                            <Button Content="Файл / Изображение"
                                    Click="BtnAddFileStep_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,5"
                                    FontSize="12"
                                    Foreground="{StaticResource TextBrush}" />

                            <Button Content="AI-шаг (OpenRouter)"
                                    Click="BtnAddAiStep_Click"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,5"
                                    FontSize="12"
                                    Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
